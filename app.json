{
  "expo": {
    "name": "RehearsalHub Studio",
    "slug": "rehearsalhub-studio",
    "scheme": [
      "rehearsalhubadmin",
      "rehearsalhub-admin"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0514"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.karaoke.rehearsalhubadmin"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0514"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.karaoke.rehearsalhubadmin"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "8ddb3927-56d5-4250-9b96-afad8db443a6"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8ddb3927-56d5-4250-9b96-afad8db443a6",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "owner": "hub11"
  }
}
